# ==============================================================================
# PRAGATI AI — Industrial Energy Platform Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the platform:
#   cp .env.example .env
#
# DO NOT commit real secrets, private keys, or credentials to version control.
# ==============================================================================

# Platform Environment
# Options: development, staging, production
PRAGATI_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Authentication & Access Control
# Used for role-based JWT issuance and legacy X-API-KEY validation
PRAGATI_API_KEY=pragati_sec_2026
API_KEY=PRAGATI_SECRET_KEY_2026
JWT_SECRET_KEY=change_me_to_a_secure_random_64_character_hex_string_in_production

# External AI LLM Reasoning Agent (Optional)
# If provided, PRAGATI AI routes high-level copilot questions to Gemini 1.5 Flash
# with privacy-shield tokenization. If omitted, the platform seamlessly falls back
# to the deterministic local rule-based copilot engine.
GEMINI_API_KEY=

# Database Configuration (TimescaleDB / PostgreSQL / SQLite)
# Default for Docker Compose is PostgreSQL with TimescaleDB hypertable extensions.
# In local development mode, SQLite telemetry persistence is used automatically.
DATABASE_URL=sqlite:///./backend/data/pragati_telemetry.db
DB_USER=pragati_admin
DB_PASSWORD=change_me_to_a_secure_password_in_production
DB_NAME=pragati_db
DB_HOST=timescaledb
DB_PORT=5432

# In-Memory Cache (Redis)
REDIS_URL=redis://localhost:6379/0
